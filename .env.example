# Copy to .env and fill in. ADO.NET string as copied from SSMS / VS Code, or an ODBC string.
SCHED_SQL_CONN="Data Source=<host>,1433;Initial Catalog=AutoScheduling;User ID=<user>;Password=<password>;Encrypt=True;Trust Server Certificate=True"
# Back-test: reuse the busy/availability data of this week for past forecast weeks (empty = same week as the schedule)
SCHED_DEFAULT_AVAILABILITY_WEEK=2026-11-16
# Web login: secret that signs the session cookie (any long random string; keep it private)
SCHED_SESSION_SECRET=<random-64-chars>
# Back-test / demo: allow scheduling past weeks (production: false). SCHED_API_DOCS=false hides /docs on production.
SCHED_ALLOW_PAST_WEEKS=true
SCHED_API_DOCS=true
